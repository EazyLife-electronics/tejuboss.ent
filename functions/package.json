{
  "name": "tejuboss-functions",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "main": "src/index.mjs",
  "scripts": {
    "test": "node --test test/catalogue.test.mjs test/checkout.test.mjs test/order-pricing.test.mjs test/quantity-pricing.test.mjs test/inventory.test.mjs test/order-security.test.mjs test/inventory-planning.test.mjs test/delivery-policy.test.mjs",
    "test:rules": "firebase emulators:exec --project tejuboss-rules-test --config ../firebase.test.json --only firestore \"node --test test/firestore-rules.test.mjs\"",
    "serve": "firebase emulators:start --only auth,functions,firestore",
    "shell": "firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0",
    "firebase-tools": "^14.0.0"
  }
}
