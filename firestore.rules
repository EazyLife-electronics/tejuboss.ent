rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'damzyeazy@gmail.com';
    }

    function hasOnlyKeys(data, keys) {
      return data.keys().hasOnly(keys);
    }

    function validText(value, minLength, maxLength) {
      return value is string
        && value.size() >= minLength
        && value.size() <= maxLength;
    }

    // Public catalogue documents must contain customer-safe fields only.
    match /catalogueProducts/{productId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    function validOrderRequest(orderId) {
      let data = request.resource.data;
      let customer = data.customer;
      let fulfilment = data.fulfilment;
      return data.keys().hasAll([
          'schemaVersion', 'orderId', 'trackingToken', 'status', 'customer', 'fulfilment',
          'lines', 'quote', 'quoteStatus', 'createdAt', 'updatedAt'
        ])
        && hasOnlyKeys(data, [
          'schemaVersion', 'orderId', 'trackingToken', 'status', 'customer', 'fulfilment',
          'lines', 'quote', 'quoteStatus', 'createdAt', 'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.orderId == orderId
        && data.trackingToken is string
        && data.trackingToken.matches('^[a-f0-9]{32}$')
        && data.status == 'awaiting_review'
        && data.quoteStatus == 'unverified'
        && customer is map
        && hasOnlyKeys(customer, ['name', 'phone', 'email'])
        && validText(customer.name, 1, 100)
        && validText(customer.phone, 7, 20)
        && (!('email' in customer) || customer.email == null || validText(customer.email, 3, 254))
        && fulfilment is map
        && hasOnlyKeys(fulfilment, ['method', 'address', 'city', 'state', 'note'])
        && fulfilment.method in ['delivery', 'pickup']
        && (!('address' in fulfilment) || validText(fulfilment.address, 0, 500))
        && (!('city' in fulfilment) || validText(fulfilment.city, 0, 100))
        && (!('state' in fulfilment) || validText(fulfilment.state, 0, 100))
        && (!('note' in fulfilment) || validText(fulfilment.note, 0, 500))
        && data.lines is list
        && data.lines.size() > 0
        && data.lines.size() <= 30
        && data.quote is map
        && hasOnlyKeys(data.quote, ['currency', 'subtotalMinor', 'deliveryFeeMinor', 'grandTotalMinor'])
        && data.quote.currency == 'NGN'
        && data.quote.subtotalMinor is int
        && data.quote.subtotalMinor >= 0
        && data.quote.deliveryFeeMinor is int
        && data.quote.deliveryFeeMinor >= 0
        && data.quote.grandTotalMinor is int
        && data.quote.grandTotalMinor >= 0
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    match /orders/{orderId} {
      allow create: if validOrderRequest(orderId);
      allow get, list, update, delete: if isAdmin();
    }

    // Public tracking exposes only a minimal status projection.
    function validInitialTracking(token) {
      let data = request.resource.data;
      return token.matches('^[a-f0-9]{32,64}$')
        && data.keys().hasAll(['orderId', 'status', 'createdAt', 'updatedAt'])
        && hasOnlyKeys(data, ['orderId', 'status', 'createdAt', 'updatedAt'])
        && validText(data.orderId, 20, 80)
        && data.status == 'submitted'
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    match /orderTracking/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if validInitialTracking(token);
      allow update, delete: if isAdmin();
    }

    match /siteSettings/public {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /siteSettings/{settingId} {
      allow read, write: if isAdmin();
    }

    match /inventoryBalances/{balanceId} {
      allow read, write: if isAdmin();
    }

    match /inventoryMovements/{movementId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /suppliers/{supplierId} {
      allow read, write: if isAdmin();
    }

    match /purchases/{purchaseId} {
      allow read, write: if isAdmin();
    }

    match /deliveries/{deliveryId} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
