rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'damzyeazy@gmail.com';
    }

    match /products/{productId} {
      // Public reads are limited to products explicitly marked in stock.
      // The storefront query must include the same predicate; admins retain full access.
      allow read: if isAdmin() || resource.data.inStock == true;
      allow write: if isAdmin();
    }

    function validGuestOrder(orderId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'items', 'customerName', 'phone', 'address', 'subtotal',
          'deliveryFee', 'total', 'trackingCode', 'status',
          'inventoryApplied', 'inventoryReturned', 'createdAt'
        ])
        && data.keys().hasOnly([
          'items', 'customerName', 'phone', 'address', 'subtotal',
          'deliveryFee', 'total', 'trackingCode', 'status',
          'inventoryApplied', 'inventoryReturned', 'createdAt'
        ])
        && data.customerName is string
        && data.customerName.size() > 0
        && data.customerName.size() <= 100
        && data.phone is string
        && data.phone.size() >= 7
        && data.phone.size() <= 20
        && data.address is string
        && data.address.size() <= 500
        && data.items is list
        && data.items.size() > 0
        && data.items.size() <= 30
        && data.subtotal is number
        && data.subtotal >= 0
        && data.deliveryFee is number
        && data.deliveryFee >= 0
        && data.total is number
        && data.total >= 0
        && data.trackingCode == orderId
        && data.status == 'new'
        && data.inventoryApplied == false
        && data.inventoryReturned == false
        && data.createdAt == request.time;
    }

    match /orders/{orderId} {
      allow create: if validGuestOrder(orderId);
      allow get, list: if isAdmin();
      allow update, delete: if isAdmin();

      match /payments/{paymentId} {
        allow read, create, update, delete: if isAdmin();
      }
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /heroes/{heroId} {
      // Public visitors receive only the callable's published-content projection.
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      // Pending reviews are private; public pages use the approved-only callable.
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasAll(['name', 'text'])
                    && request.resource.data.name is string
                    && request.resource.data.text is string;
      allow update, delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'need'])
                    && request.resource.data.name is string
                    && request.resource.data.phone is string;
      allow read, update, delete: if isAdmin();
    }

    match /inventoryMovements/{movementId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /purchases/{purchaseId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /deliveryPersonnel/{personId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /deliveryTypes/{typeId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /deliveryCheckpoints/{checkpointId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /deliveries/{deliveryId} {
      // Delivery records contain private customer and operational details.
      // Public tracking must use a trusted, minimized response; raw documents
      // are never readable by unauthenticated clients.
      allow get, list, create, update, delete: if isAdmin();
    }
  }
}